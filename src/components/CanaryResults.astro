---
import type { CanaryObservation } from "@/data/canary-results";

type Props = {
  results: CanaryObservation[];
};

const { results } = Astro.props;
---

<div class="canary-table-wrap">
  <table class="canary-table">
    <thead>
      <tr>
        <th scope="col">Engine</th>
        <th scope="col">Date</th>
        <th scope="col">Vectors echoed</th>
        <th scope="col">Notes</th>
      </tr>
    </thead>
    <tbody>
      {
        results.map(row => (
          <tr>
            <td data-label="Engine">{row.engine}</td>
            <td data-label="Date">{row.date}</td>
            <td data-label="Vectors echoed">
              {row.vectorsEchoed.length > 0 ? (
                <ul class="vector-pills" role="list">
                  {row.vectorsEchoed.map(v => (
                    <li class="vector-pill">{v}</li>
                  ))}
                </ul>
              ) : (
                <span class="text-foreground/50 italic">none</span>
              )}
            </td>
            <td data-label="Notes">{row.notes}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .canary-table-wrap {
    width: 100%;
    overflow-x: auto;
    border-radius: 0.75rem;
  }

  .canary-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .canary-table th,
  .canary-table td {
    padding: 0.65rem 1rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 30%, transparent);
  }

  .canary-table th {
    font-family: var(--font-firacode);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    white-space: nowrap;
  }

  .canary-table thead tr:first-child th:first-child {
    border-top-left-radius: 0.75rem;
  }

  .canary-table thead tr:first-child th:last-child {
    border-top-right-radius: 0.75rem;
  }

  .canary-table tbody tr:last-child td {
    border-bottom: none;
  }

  .canary-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: 0.75rem;
  }

  .canary-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: 0.75rem;
  }

  .canary-table tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }

  .vector-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .vector-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    padding: 0.1rem 0.4rem;
    border-radius: 0.35rem;
    font-family: var(--font-firacode);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }
</style>
