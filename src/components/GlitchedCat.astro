---
import { readFileSync } from "node:fs";

interface Props {
  size?: "small" | "large";
}
const { size = "large" } = Astro.props;

const fontSize = size === "small" ? "1.25rem" : "44px";
const marginLeft = size === "small" ? "4px" : "6px";
const idSuffix = Math.random().toString(36).substring(2, 9);
const gtxtId = `gtxt-${idSuffix}`;
const l1Id = `l1-${idSuffix}`;
const l2Id = `l2-${idSuffix}`;
const curId = `cur-${idSuffix}`;
const catL1Id = `catl1-${idSuffix}`;
const catL2Id = `catl2-${idSuffix}`;

const catSvg = readFileSync("src/assets/logo/cat.svg", "utf8");
const catPathMatch = catSvg.match(/d="([^"]+)"/);
const catPathData = catPathMatch ? catPathMatch[1] : "";
---

<div id={gtxtId} style={`position:relative;display:inline-flex;align-items:center;gap:0.15em;font-family:var(--font-firacode);font-size:${fontSize};font-weight:700;letter-spacing:1px;`} class="glitch-text text-foreground shrink-0">
  <!-- Cat mark layers -->
  <span class="glitch-cat-wrap" style="position:relative;display:inline-block;height:1em;flex-shrink:0;">
    <svg id={catL1Id} style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:0;color:#00ffff;" viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d={catPathData} fill="currentColor"/>
    </svg>
    <svg id={catL2Id} style="position:absolute;left:0;top:0;width:100%;height:100%;opacity:0;color:#ff00ff;" viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d={catPathData} fill="currentColor"/>
    </svg>
    <svg style="position:relative;width:100%;height:100%;" viewBox="0 0 1024 1024" aria-hidden="true" focusable="false">
      <path fill-rule="evenodd" d={catPathData} fill="currentColor"/>
    </svg>
  </span>

  <!-- Wordmark layers -->
  <span class="glitch-wordmark-wrap" style="position:relative;">
    <span id={l1Id} style="position:absolute;left:0;top:0;color:#00ffff;opacity:0;">Glitched_Cat</span>
    <span id={l2Id} style="position:absolute;left:0;top:0;color:#ff00ff;opacity:0;">Glitched_Cat</span>
    <span style="position:relative;">Glitched_Cat<span id={curId} style={`display:inline-block;width:0.55em;height:1em;background:var(--accent);vertical-align:-0.12em;margin-left:${marginLeft};`}></span></span>
  </span>
</div>

<script is:inline define:vars={{ gtxtId, l1Id, l2Id, curId, catL1Id, catL2Id }}>
  document.addEventListener("astro:page-load", () => {
    const l1 = document.getElementById(l1Id);
    const l2 = document.getElementById(l2Id);
    const catL1 = document.getElementById(catL1Id);
    const catL2 = document.getElementById(catL2Id);
    const g = document.getElementById(gtxtId);
    const cur = document.getElementById(curId);
    
    if (!g || !l1 || !l2 || !cur || !catL1 || !catL2) return;
    
    const curTimer = setInterval(() => {
      cur.style.opacity = cur.style.opacity === '0' ? '1' : '0';
    }, 530);
    
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    const layers = [l1, l2, catL1, catL2];
    
    function burst() {
      if (reduce) return;
      let n = 0;
      const t = setInterval(() => {
        n++;
        const dx = () => (Math.random() * 8 - 4) + 'px';
        const dy = () => (Math.random() * 4 - 2) + 'px';
        
        layers.forEach(el => {
          el.style.opacity = '0.8';
          el.style.transform = `translate(${dx()}, ${dy()})`;
        });
        
        const top = Math.floor(Math.random() * 60);
        const bot = Math.min(top + Math.floor(Math.random() * 30) + 10, 100);
        g.style.clipPath = Math.random() > 0.5 ? `inset(${top}% 0 ${100 - bot}% 0)` : 'none';
        
        if (n > 6) {
          clearInterval(t);
          layers.forEach(el => {
            el.style.opacity = '0';
          });
          g.style.clipPath = 'none';
        }
      }, 50);
    }
    
    const burstTimer = setInterval(burst, 2800 + (Math.random() * 500));
    setTimeout(burst, 600);
    
    document.addEventListener("astro:before-swap", () => {
      clearInterval(curTimer);
      clearInterval(burstTimer);
    }, { once: true });
  });
</script>
